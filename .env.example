# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Human-readable logs (requires the pino-pretty dev dependency)
LOG_PRETTY=false

# ---------------------------------------------------------------------------
# Google Cloud Storage (authenticated with Application Default Credentials)
# Run `gcloud auth application-default login` locally; on GKE/Cloud Run the
# attached service account (Workload Identity) is used. Do NOT set
# GOOGLE_APPLICATION_CREDENTIALS to a key file, and never commit key files.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=gcs
GCS_BUCKET=your-orders-bucket
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCS_UPLOAD_PREFIX=orders/uploads
# Only for a local GCS emulator such as fake-gcs-server (e.g. http://127.0.0.1:4443).
# Leave unset for real GCS. `npm run dev` sets it automatically when no bucket is configured.
# GCS_API_ENDPOINT=
# Only used when STORAGE_DRIVER=local (offline development/tests, no GCS involved)
LOCAL_STORAGE_DIR=./.local-storage

# ---------------------------------------------------------------------------
# PostgreSQL
# META database: job queue + rejected rows (not sharded).
# SHARD databases: comma-separated, ORDERED list. Position N == shard N.
# Never reorder or remove entries once data exists (see README "Sharding").
# ---------------------------------------------------------------------------
META_DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders_meta
SHARD_DATABASE_URLS=postgres://postgres:postgres@localhost:5433/orders,postgres://postgres:postgres@localhost:5434/orders,postgres://postgres:postgres@localhost:5435/orders
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000
# Fixed for the lifetime of the cluster (changing it re-maps every key).
SHARD_VIRTUAL_BUCKETS=1024

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
INSERT_BATCH_SIZE=1000
REJECT_BATCH_SIZE=500
MAX_UPLOAD_BYTES=104857600
# UPLOAD_TMP_DIR=/tmp
PROGRESS_EVERY_ROWS=2000
# Max time POST /upload-orders?wait=true blocks before returning 202
UPLOAD_WAIT_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Background worker
# ---------------------------------------------------------------------------
# Run a worker inside the API process. Set false when running `npm run start:worker` separately.
RUN_EMBEDDED_WORKER=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=3
# A 'processing' job whose heartbeat is older than this is assumed orphaned and reclaimed.
JOB_STALE_LOCK_SECONDS=300
