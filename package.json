{
  "name": "orders-ingestion-service",
  "version": "1.0.0",
  "description": "Streams order files into GCS and a sharded PostgreSQL cluster",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "dev": "node scripts/dev.js",
    "migrate": "node scripts/migrate.js",
    "generate:orders": "node scripts/generate-orders.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\""
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "busboy": "^1.6.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  }
